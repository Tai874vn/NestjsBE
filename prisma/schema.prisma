generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String?
  phone         String?
  birthDay      String?
  gender        String?
  role          String   @default("user")
  skill         String?
  certification String?
  headline      String?
  bio           String?
  location      String?
  website       String?
  googleId      String?  @unique
  avatar        String?
  coverImage    String?
  profileCompleted Boolean @default(false)
  candidateDiscoverable Boolean @default(true)
  refreshToken  String?
  tokenVersion  Int      @default(0)
  bannedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments         Comment[]
  hires            Hire[]
  jobs             Job[]            @relation("JobCreator")
  profileSkills    UserSkill[]
  profileCertifications UserCertification[]
  portfolioItems   UserPortfolioItem[]
  resume           UserResume?
  chatRoomsCreated ChatRoom[]       @relation("ChatRoomCreator")
  chatRoomMembers  ChatRoomMember[]
  chatMessages     ChatMessage[]
  posts            Post[]
  postComments     PostComment[]
  postLikes        PostLike[]
  savedPosts       SavedPost[]
  savedJobs        SavedJob[]
  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionRecipient")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  recommendationSnapshots RecommendationSnapshot[]
  recommendationQuotaUsages RecommendationQuotaUsage[]
  hiringPosts     HiringPost[]      @relation("HiringPostRecruiter")
  hiringApplications HiringApplication[] @relation("HiringApplicationApplicant")
  authSessions AuthSession[]

  @@index([role, profileCompleted, updatedAt, id])
  @@index([role, candidateDiscoverable, profileCompleted, updatedAt, id])
  @@map("users")
}

model AuthSession {
  id           String   @id @db.Uuid
  familyId     String   @unique @db.Uuid
  userId       Int
  tokenVersion Int
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id           String   @id @db.Uuid
  sessionId    String   @db.Uuid
  tokenHash    String   @unique @db.Char(64)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?  @db.Uuid
  session      AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   AuthRefreshToken? @relation("RefreshReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthRefreshToken[] @relation("RefreshReplacement")

  @@index([sessionId, expiresAt])
  @@map("auth_refresh_tokens")
}

model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  level     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("user_skills")
}

model UserCertification {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  credentialId  String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certifications")
}

model UserPortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  image       String?
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_portfolio_items")
}

model UserResume {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  data           Json
  sourceFileName String?
  sourceFileUrl  String?
  sourceFileMimeType String?
  sourceFileSize Int?
  sourceFilePublicId String?
  predictedSeniority String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel String?
  predictedSeniorityMetadata Json?
  predictedSeniorityAt DateTime?
  schemaVersion  String   @default("v1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_resumes")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int     @id @default(autoincrement())
  name       String
  image      String?
  categoryId Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@map("subcategories")
}

model Job {
  id               Int      @id @default(autoincrement())
  title            String
  reviews          Int      @default(0)
  price            Int
  image            String?
  description      String?
  shortDescription String?
  rating           Int      @default(0)
  subcategoryId    Int
  creatorId        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  user        User        @relation("JobCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  hires       Hire[]
  savedBy     SavedJob[]
  recommendationSnapshots RecommendationSnapshot[]

  @@index([creatorId, id])
  @@index([subcategoryId, id])
  @@index([createdAt, id])
  @@index([price, id])
  @@index([rating, id])
  @@map("jobs")
}

model Comment {
  id          Int      @id @default(autoincrement())
  jobId       Int
  commenterId Int
  commentedAt DateTime @default(now())
  content     String
  rating      Int

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [commenterId], references: [id], onDelete: Cascade)

  @@index([jobId, commentedAt])
  @@map("comments")
}

model Hire {
  id        Int      @id @default(autoincrement())
  jobId     Int
  hirerId   Int
  hiredAt   DateTime @default(now())
  completed Boolean  @default(false)

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [hirerId], references: [id], onDelete: Cascade)

  @@index([hirerId, completed, hiredAt])
  @@index([jobId, completed])
  @@map("hires")
}

model Post {
  id            Int      @id @default(autoincrement())
  authorId      Int
  content       String
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]
  likes    PostLike[]
  savedBy  SavedPost[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int
  parentId  Int?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent PostComment? @relation("PostCommentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@unique([id, postId])
  @@index([postId, id])
  @@index([postId, parentId, id])
  @@map("post_comments")
}

model PostLike {
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model SavedPost {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
  @@map("saved_posts")
}

model SavedJob {
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([userId, createdAt, jobId])
  @@map("saved_jobs")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  HIRE_CREATED
  HIRE_COMPLETED
  CHAT_MESSAGE
}

enum RecommendationSnapshotKind {
  JOBS
  CANDIDATES
}

enum HiringPostStatus {
  OPEN
  CLOSED
}

enum HiringApplicationStatus {
  APPLIED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Connection {
  id          Int              @id @default(autoincrement())
  pairKey     String           @unique
  requesterId Int
  recipientId Int
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, updatedAt])
  @@index([recipientId, status, updatedAt])
  @@map("connections")
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  actorId     Int?
  type        NotificationType
  title       String
  body        String
  entityType  String?
  entityId    Int?
  actionUrl   String?
  metadata    Json?
  dedupeKey   String?          @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt, id])
  @@index([recipientId, id])
  @@index([recipientId, updatedAt, id])
  @@index([actorId])
  @@map("notifications")
}

model RecommendationSnapshot {
  id          Int                        @id @default(autoincrement())
  scopeKey    String                     @unique
  userId      Int
  kind        RecommendationSnapshotKind
  jobId       Int?
  hiringPostId Int?
  topK        Int
  poolSize    Int
  data        Json
  modelName   String?
  elapsedMs   Float?
  generatedAt DateTime
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hiringPost HiringPost? @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)

  @@index([userId, kind, jobId])
  @@index([userId, kind, hiringPostId])
  @@index([updatedAt])
  @@map("recommendation_snapshots")
}

model RecommendationQuotaUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  day       DateTime @db.Date
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("recommendation_quota_usages")
}

model HiringPost {
  id             Int              @id @default(autoincrement())
  recruiterId    Int
  title          String
  description    String
  requirements   String?
  location       String?
  employmentType String?
  salaryMin      Int?
  salaryMax      Int?
  predictedSeniority String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel String?
  predictedSeniorityMetadata Json?
  predictedSeniorityAt DateTime?
  status         HiringPostStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  recruiter User @relation("HiringPostRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  recommendationSnapshots RecommendationSnapshot[]
  applications HiringApplication[]

  @@index([recruiterId, status, updatedAt, id])
  @@index([status, updatedAt, id])
  @@map("hiring_posts")
}

model HiringApplication {
  id           Int                     @id @default(autoincrement())
  hiringPostId Int
  applicantId  Int
  coverLetter  String?
  status       HiringApplicationStatus @default(APPLIED)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  hiringPost HiringPost @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)
  applicant  User       @relation("HiringApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([hiringPostId, applicantId])
  @@index([applicantId, status, updatedAt, id])
  @@index([hiringPostId, status, updatedAt, id])
  @@map("hiring_applications")
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String?
  isPrivate Boolean  @default(true)
  directKey String?  @unique
  creatorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User             @relation("ChatRoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members  ChatRoomMember[]
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  roomId     Int
  userId     Int
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, roomId])
  @@map("chat_room_members")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, id])
  @@map("chat_messages")
}
