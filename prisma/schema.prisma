generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String?
  phone         String?
  birthDay      String?
  gender        String?
  role          String   @default("user")
  skill         String?
  certification String?
  headline      String?
  bio           String?
  location      String?
  website       String?
  googleId      String?  @unique
  avatar        String?
  coverImage    String?
  profileCompleted Boolean @default(false)
  /// Candidates opt in to candidate search and AI matching ("Visible to recruiters").
  candidateDiscoverable Boolean @default(false)
  refreshToken  String?
  tokenVersion  Int      @default(0)
  bannedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments         Comment[]
  hires            Hire[]
  jobs             Job[]            @relation("JobCreator")
  profileSkills    UserSkill[]
  profileCertifications UserCertification[]
  portfolioItems   UserPortfolioItem[]
  resume           UserResume?
  chatRoomsCreated ChatRoom[]       @relation("ChatRoomCreator")
  chatRoomMembers  ChatRoomMember[]
  chatMessages     ChatMessage[]
  posts            Post[]
  postComments     PostComment[]
  postLikes        PostLike[]
  savedPosts       SavedPost[]
  savedJobs        SavedJob[]
  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionRecipient")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")
  recommendationSnapshots RecommendationSnapshot[]
  recommendationQuotaUsages RecommendationQuotaUsage[]
  hiringPosts     HiringPost[]      @relation("HiringPostRecruiter")
  hiringApplications HiringApplication[] @relation("HiringApplicationApplicant")
  authSessions AuthSession[]
  interviewsCreated Interview[] @relation("InterviewCreator")
  hiringApplicationEvents HiringApplicationEvent[] @relation("HiringApplicationEventActor")

  @@index([role, profileCompleted, updatedAt, id])
  @@index([role, candidateDiscoverable, profileCompleted, updatedAt, id])
  @@map("users")
}

model AuthSession {
  id           String   @id @db.Uuid
  familyId     String   @unique @db.Uuid
  userId       Int
  tokenVersion Int
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id           String   @id @db.Uuid
  sessionId    String   @db.Uuid
  tokenHash    String   @unique @db.Char(64)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?  @db.Uuid
  session      AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   AuthRefreshToken? @relation("RefreshReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthRefreshToken[] @relation("RefreshReplacement")

  @@index([sessionId, expiresAt])
  @@map("auth_refresh_tokens")
}

model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  /// Id in the AI service's skill dictionary (ESCO or O*NET), e.g. "onet:react". Null for skills saved before it.
  skillId   String?
  level     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("user_skills")
}

model UserCertification {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  credentialId  String?
  /// Kind of credential (schema.org credentialCategory): Certification, License, Course, or Badge.
  category      String?
  /// Dictionary skills the credential shows.
  skills        String[]  @default([])
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certifications")
}

model UserPortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  image       String?
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_portfolio_items")
}

model UserResume {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  data           Json
  sourceFileName String?
  sourceFileUrl  String?
  sourceFileMimeType String?
  sourceFileSize Int?
  sourceFilePublicId String?
  predictedSeniority String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel String?
  predictedSeniorityMetadata Json?
  predictedSeniorityAt DateTime?
  /// AI work queue: QUEUED, PROCESSING, DONE, AI_UNAVAILABLE, NEEDS_INPUT, or FAILED. Null = never queued.
  aiStatus       String?
  aiStatusMessage String?
  aiQueuedAt     DateTime?
  aiClaimedAt    DateTime?
  aiAttempts     Int      @default(0)
  /// Skills suggested from the CV text and skills the dictionary didn't recognise.
  aiInsights     Json?
  schemaVersion  String   @default("v1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiStatus, aiQueuedAt])
  @@map("user_resumes")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int     @id @default(autoincrement())
  name       String
  image      String?
  categoryId Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@map("subcategories")
}

model Job {
  id               Int      @id @default(autoincrement())
  title            String
  reviews          Int      @default(0)
  price            Int
  image            String?
  description      String?
  shortDescription String?
  rating           Int      @default(0)
  subcategoryId    Int
  creatorId        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  user        User        @relation("JobCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  hires       Hire[]
  savedBy     SavedJob[]
  recommendationSnapshots RecommendationSnapshot[]

  @@index([creatorId, id])
  @@index([subcategoryId, id])
  @@index([createdAt, id])
  @@index([price, id])
  @@index([rating, id])
  @@map("jobs")
}

model Comment {
  id          Int      @id @default(autoincrement())
  jobId       Int
  commenterId Int
  commentedAt DateTime @default(now())
  content     String
  rating      Int

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [commenterId], references: [id], onDelete: Cascade)

  @@index([jobId, commentedAt])
  @@map("comments")
}

model Hire {
  id        Int      @id @default(autoincrement())
  jobId     Int
  hirerId   Int
  hiredAt   DateTime @default(now())
  completed Boolean  @default(false)

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [hirerId], references: [id], onDelete: Cascade)

  @@index([hirerId, completed, hiredAt])
  @@index([jobId, completed])
  @@map("hires")
}

model Post {
  id            Int      @id @default(autoincrement())
  authorId      Int
  content       String
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]
  likes    PostLike[]
  savedBy  SavedPost[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int
  parentId  Int?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent PostComment? @relation("PostCommentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@unique([id, postId])
  @@index([postId, id])
  @@index([postId, parentId, id])
  @@map("post_comments")
}

model PostLike {
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model SavedPost {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
  @@map("saved_posts")
}

model SavedJob {
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([userId, createdAt, jobId])
  @@map("saved_jobs")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  HIRE_CREATED
  HIRE_COMPLETED
  CHAT_MESSAGE
  APPLICATION_RECEIVED
  APPLICATION_UPDATE
  INTERVIEW_UPDATE
}

enum RecommendationSnapshotKind {
  JOBS
  CANDIDATES
}

enum HiringPostStatus {
  OPEN
  CLOSED
}

enum HiringApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  DECLINED
  WITHDRAWN
}

/// How an interview happens.
enum InterviewMode {
  ONLINE
  ONSITE
  PHONE
}

/// Where an interview is in its life: proposed times, a reschedule ask, booked, done or cancelled.
enum InterviewStatus {
  PROPOSED
  RESCHEDULE_REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Connection {
  id          Int              @id @default(autoincrement())
  pairKey     String           @unique
  requesterId Int
  recipientId Int
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, updatedAt])
  @@index([recipientId, status, updatedAt])
  @@map("connections")
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  actorId     Int?
  type        NotificationType
  title       String
  body        String
  entityType  String?
  entityId    Int?
  actionUrl   String?
  metadata    Json?
  dedupeKey   String?          @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt, id])
  @@index([recipientId, id])
  @@index([recipientId, updatedAt, id])
  @@index([actorId])
  @@map("notifications")
}

model RecommendationSnapshot {
  id          Int                        @id @default(autoincrement())
  scopeKey    String                     @unique
  userId      Int
  kind        RecommendationSnapshotKind
  jobId       Int?
  hiringPostId Int?
  topK        Int
  poolSize    Int
  data        Json
  modelName   String?
  elapsedMs   Float?
  generatedAt DateTime
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hiringPost HiringPost? @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)

  @@index([userId, kind, jobId])
  @@index([userId, kind, hiringPostId])
  @@index([updatedAt])
  @@map("recommendation_snapshots")
}

model RecommendationQuotaUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  day       DateTime @db.Date
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("recommendation_quota_usages")
}

model HiringPost {
  id             Int              @id @default(autoincrement())
  recruiterId    Int
  title          String
  description    String
  requirements   String?
  location       String?
  employmentType String?
  salaryMin      Int?
  salaryMax      Int?
  /// ISO 4217 currency of salaryMin/salaryMax.
  salaryCurrency String           @default("USD")
  /// What the salary is paid per: month, year or hour.
  salaryPeriod   String           @default("month")
  /// Shown on the post instead of the recruiter's display name.
  companyName    String?
  /// ESCO occupation code (src/common/data/occupations.json) the post hires for.
  occupationCode String?
  /// One of the occupation's specialties (O*NET titles listed under it), optional.
  specialty      String?
  /// The post's old career field (one of the 37), kept read-only from before occupations.
  legacyField    String?
  /// Minimum years of experience in the occupation.
  yearsRequired  Int?
  /// Skill names picked from the dictionary.
  skills         String[]         @default([])
  /// After this time the post is no longer listed as open.
  closesAt       DateTime?
  predictedSeniority String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel String?
  predictedSeniorityMetadata Json?
  predictedSeniorityAt DateTime?
  /// AI level queue: QUEUED, PROCESSING, DONE, AI_UNAVAILABLE, NEEDS_INPUT, or FAILED. Null = never queued.
  aiStatus       String?
  aiStatusMessage String?
  aiQueuedAt     DateTime?
  aiClaimedAt    DateTime?
  aiAttempts     Int              @default(0)
  /// How many people the post wants to hire. Null means no limit.
  openings       Int?             @default(1)
  status         HiringPostStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  recruiter User @relation("HiringPostRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  recommendationSnapshots RecommendationSnapshot[]
  applications HiringApplication[]

  @@index([recruiterId, status, updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([status, occupationCode])
  /// sort=closing_soon: closesAt ASC is NULLS LAST in Postgres, as the query asks.
  @@index([status, closesAt, id(sort: Desc)])
  /// sort=salary_high. The migration creates it with NULLS LAST, which Prisma cannot express.
  @@index([status, salaryMax(sort: Desc), salaryMin(sort: Desc), id(sort: Desc)])
  @@index([aiStatus, aiQueuedAt])
  @@map("hiring_posts")
}

model HiringApplication {
  id           Int                     @id @default(autoincrement())
  hiringPostId Int
  applicantId  Int
  coverLetter  String?
  status       HiringApplicationStatus @default(APPLIED)
  /// Short reason code for the latest status change (for example why it was rejected).
  statusReason String?
  /// Free text that goes with the latest status change.
  statusNote   String?
  /// Message the recruiter sends with an offer.
  offerNote    String?
  offeredAt    DateTime?
  /// When the applicant accepted or declined the offer.
  decidedAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  hiringPost HiringPost @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)
  applicant  User       @relation("HiringApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  interviews Interview[]
  events     HiringApplicationEvent[]

  @@unique([hiringPostId, applicantId])
  @@index([applicantId, status, updatedAt, id])
  @@index([hiringPostId, status, updatedAt, id])
  @@map("hiring_applications")
}

/// One interview round for an application.
model Interview {
  id              Int             @id @default(autoincrement())
  applicationId   Int
  /// 1 for the first interview, 2 for the second, and so on.
  round           Int
  mode            InterviewMode
  durationMinutes Int             @default(45)
  /// Address, meeting link or phone number.
  location        String?
  note            String?
  /// Times the recruiter offers; the applicant picks one.
  proposedTimes   DateTime[]
  scheduledAt     DateTime?
  status          InterviewStatus @default(PROPOSED)
  /// Why the applicant asked for other times.
  rescheduleNote  String?
  createdById     Int
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("InterviewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  /// The migration also adds a partial unique index (an index over only some rows):
  /// at most one PROPOSED, RESCHEDULE_REQUESTED or SCHEDULED interview per application.
  @@index([applicationId, round])
  @@index([status, scheduledAt])
  @@map("interviews")
}

/// History of one application: each status change, interview change or note, in time order.
model HiringApplicationEvent {
  id            Int      @id @default(autoincrement())
  applicationId Int
  /// Who did it. Null when the user is gone or the system did it.
  actorId       Int?
  type          String
  data          Json?
  createdAt     DateTime @default(now())

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?             @relation("HiringApplicationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("hiring_application_events")
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String?
  isPrivate Boolean  @default(true)
  directKey String?  @unique
  creatorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User             @relation("ChatRoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members  ChatRoomMember[]
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  roomId     Int
  userId     Int
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, roomId])
  @@map("chat_room_members")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, id])
  @@map("chat_messages")
}
