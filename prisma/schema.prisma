generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String    @unique
  password              String?
  phone                 String?
  birthDay              String?
  gender                String?
  role                  String    @default("user")
  skill                 String?
  certification         String?
  headline              String?
  bio                   String?
  location              String?
  website               String?
  googleId              String?   @unique
  avatar                String?
  coverImage            String?
  profileCompleted      Boolean   @default(false)
  /// Candidates opt in to candidate search and AI matching ("Visible to recruiters").
  candidateDiscoverable Boolean   @default(false)
  refreshToken          String?
  tokenVersion          Int       @default(0)
  bannedAt              DateTime?
  /// When the user proved they own `email` (link in a mail, or Google). Null = not proved yet: no password sign-in.
  emailVerifiedAt       DateTime?
  /// A new address the user asked for; it replaces `email` only after the link sent to it is opened.
  pendingEmail          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  emailTokens               EmailToken[]
  comments                  Comment[]
  jobs                      Job[]                      @relation("JobCreator")
  profileSkills             UserSkill[]
  profileCertifications     UserCertification[]
  portfolioItems            UserPortfolioItem[]
  resume                    UserResume?
  chatRoomsCreated          ChatRoom[]                 @relation("ChatRoomCreator")
  chatRoomMembers           ChatRoomMember[]
  chatMessages              ChatMessage[]
  posts                     Post[]
  postComments              PostComment[]
  postLikes                 PostLike[]
  savedPosts                SavedPost[]
  savedJobs                 SavedJob[]
  sentConnections           Connection[]               @relation("ConnectionRequester")
  receivedConnections       Connection[]               @relation("ConnectionRecipient")
  notificationsReceived     Notification[]             @relation("NotificationRecipient")
  notificationsActed        Notification[]             @relation("NotificationActor")
  recommendationSnapshots   RecommendationSnapshot[]
  recommendationQuotaUsages RecommendationQuotaUsage[]
  hiringPosts               HiringPost[]               @relation("HiringPostRecruiter")
  hiringApplications        HiringApplication[]        @relation("HiringApplicationApplicant")
  authSessions              AuthSession[]
  interviewsCreated         Interview[]                @relation("InterviewCreator")
  hiringApplicationEvents   HiringApplicationEvent[]   @relation("HiringApplicationEventActor")
  proposalsAsClient         Proposal[]                 @relation("ProposalClient")
  proposalsAsFreelancer     Proposal[]                 @relation("ProposalFreelancer")
  proposalsToAnswer         Proposal[]                 @relation("ProposalTurnUser")
  proposalVersions          ProposalVersion[]          @relation("ProposalVersionAuthor")
  contractsAsClient         Contract[]                 @relation("ContractClient")
  contractsAsFreelancer     Contract[]                 @relation("ContractFreelancer")
  contractEndRequests       Contract[]                 @relation("ContractEndRequester")
  submissions               Submission[]               @relation("SubmissionAuthor")
  amendments                Amendment[]                @relation("AmendmentProposer")
  contractEvents            ContractEvent[]            @relation("ContractEventActor")
  wallet                    Wallet?
  ledgerEntries             LedgerEntry[]              @relation("LedgerEntryOwner")
  ledgerCounterparty        LedgerEntry[]              @relation("LedgerEntryCounterparty")
  topUps                    TopUp[]

  @@index([role, profileCompleted, updatedAt, id])
  @@index([role, candidateDiscoverable, profileCompleted, updatedAt, id])
  @@map("users")
}

model AuthSession {
  id            String             @id @db.Uuid
  familyId      String             @unique @db.Uuid
  userId        Int
  tokenVersion  Int
  userAgent     String?
  ip            String?
  createdAt     DateTime           @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id           String             @id @db.Uuid
  sessionId    String             @db.Uuid
  tokenHash    String             @unique @db.Char(64)
  createdAt    DateTime           @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  replacedById String?            @db.Uuid
  session      AuthSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   AuthRefreshToken?  @relation("RefreshReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthRefreshToken[] @relation("RefreshReplacement")

  @@index([sessionId, expiresAt])
  @@map("auth_refresh_tokens")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One-time links sent by mail. Only the SHA-256 of the token is saved, so a database leak gives no working link.
model EmailToken {
  id        Int               @id @default(autoincrement())
  userId    Int
  purpose   EmailTokenPurpose
  tokenHash String            @unique @db.Char(64)
  /// The address the link was sent to (for VERIFY_EMAIL, the address it proves).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("email_tokens")
}

model UserSkill {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  /// Id in the AI service's skill dictionary (ESCO or O*NET), e.g. "onet:react". Null for skills saved before it.
  skillId   String?
  level     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("user_skills")
}

model UserCertification {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  credentialId  String?
  /// Kind of credential (schema.org credentialCategory): Certification, License, Course, or Badge.
  category      String?
  /// Dictionary skills the credential shows.
  skills        String[]  @default([])
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certifications")
}

model UserPortfolioItem {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  image       String?
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_portfolio_items")
}

model UserResume {
  id                           Int       @id @default(autoincrement())
  userId                       Int       @unique
  data                         Json
  sourceFileName               String?
  sourceFileUrl                String?
  sourceFileMimeType           String?
  sourceFileSize               Int?
  sourceFilePublicId           String?
  predictedSeniority           String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel      String?
  predictedSeniorityMetadata   Json?
  predictedSeniorityAt         DateTime?
  /// AI work queue: QUEUED, PROCESSING, DONE, AI_UNAVAILABLE, NEEDS_INPUT, or FAILED. Null = never queued.
  aiStatus                     String?
  aiStatusMessage              String?
  aiQueuedAt                   DateTime?
  aiClaimedAt                  DateTime?
  aiAttempts                   Int       @default(0)
  /// Skills suggested from the CV text and skills the dictionary didn't recognise.
  aiInsights                   Json?
  schemaVersion                String    @default("v1")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiStatus, aiQueuedAt])
  @@map("user_resumes")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id         Int     @id @default(autoincrement())
  name       String
  image      String?
  categoryId Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@map("subcategories")
}

model Job {
  id                Int      @id @default(autoincrement())
  title             String
  reviews           Int      @default(0)
  price             Int
  image             String?
  description       String?
  shortDescription  String?
  rating            Int      @default(0)
  subcategoryId     Int
  creatorId         Int
  /// Where the work happens: REMOTE, ONSITE or BOTH.
  workMode          WorkMode @default(REMOTE)
  /// The area the seller covers for onsite work (free text).
  serviceArea       String?
  /// Optional split the seller suggests: a JSON list of { title, description?, share }, shares add to 100.
  milestoneTemplate Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subcategory             Subcategory              @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  user                    User                     @relation("JobCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments                Comment[]
  proposals               Proposal[]
  contracts               Contract[]
  savedBy                 SavedJob[]
  recommendationSnapshots RecommendationSnapshot[]

  @@index([creatorId, id])
  @@index([subcategoryId, id])
  @@index([createdAt, id])
  @@index([price, id])
  @@index([rating, id])
  @@map("jobs")
}

model Comment {
  id          Int      @id @default(autoincrement())
  jobId       Int
  commenterId Int
  commentedAt DateTime @default(now())
  content     String
  rating      Int
  /// The contract this review is for. Null for old reviews written before contracts.
  contractId  Int?     @unique

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [commenterId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([jobId, commentedAt])
  @@map("comments")
}

model Post {
  id            Int      @id @default(autoincrement())
  authorId      Int
  content       String
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]
  likes    PostLike[]
  savedBy  SavedPost[]

  @@index([createdAt, id])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  Int
  parentId  Int?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("PostCommentReplies", fields: [parentId, postId], references: [id, postId], onDelete: Cascade)
  replies PostComment[] @relation("PostCommentReplies")

  @@unique([id, postId])
  @@index([postId, id])
  @@index([postId, parentId, id])
  @@map("post_comments")
}

model PostLike {
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model SavedPost {
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
  @@map("saved_posts")
}

model SavedJob {
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([userId, createdAt, jobId])
  @@map("saved_jobs")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  POST_COMMENT
  HIRE_CREATED
  HIRE_COMPLETED
  CHAT_MESSAGE
  APPLICATION_RECEIVED
  APPLICATION_UPDATE
  INTERVIEW_UPDATE
  PROPOSAL_UPDATE
  CONTRACT_UPDATE
}

enum RecommendationSnapshotKind {
  JOBS
  CANDIDATES
}

enum HiringPostStatus {
  OPEN
  CLOSED
}

enum HiringApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  DECLINED
  WITHDRAWN
}

/// How an interview happens.
enum InterviewMode {
  ONLINE
  ONSITE
  PHONE
}

/// Where an interview is in its life: proposed times, a reschedule ask, booked, done or cancelled.
enum InterviewStatus {
  PROPOSED
  RESCHEDULE_REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Connection {
  id          Int              @id @default(autoincrement())
  pairKey     String           @unique
  requesterId Int
  recipientId Int
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, updatedAt])
  @@index([recipientId, status, updatedAt])
  @@map("connections")
}

model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  actorId     Int?
  type        NotificationType
  title       String
  body        String
  entityType  String?
  entityId    Int?
  actionUrl   String?
  metadata    Json?
  dedupeKey   String?          @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt, id])
  @@index([recipientId, id])
  @@index([recipientId, updatedAt, id])
  @@index([actorId])
  @@map("notifications")
}

model RecommendationSnapshot {
  id           Int                        @id @default(autoincrement())
  scopeKey     String                     @unique
  userId       Int
  kind         RecommendationSnapshotKind
  jobId        Int?
  hiringPostId Int?
  topK         Int
  poolSize     Int
  data         Json
  modelName    String?
  elapsedMs    Float?
  generatedAt  DateTime
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hiringPost HiringPost? @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)

  @@index([userId, kind, jobId])
  @@index([userId, kind, hiringPostId])
  @@index([updatedAt])
  @@map("recommendation_snapshots")
}

model RecommendationQuotaUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  day       DateTime @db.Date
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("recommendation_quota_usages")
}

model HiringPost {
  id                           Int              @id @default(autoincrement())
  recruiterId                  Int
  title                        String
  description                  String
  requirements                 String?
  location                     String?
  employmentType               String?
  salaryMin                    Int?
  salaryMax                    Int?
  /// ISO 4217 currency of salaryMin/salaryMax.
  salaryCurrency               String           @default("USD")
  /// What the salary is paid per: month, year or hour.
  salaryPeriod                 String           @default("month")
  /// Shown on the post instead of the recruiter's display name.
  companyName                  String?
  /// ESCO occupation code (src/common/data/occupations.json) the post hires for.
  occupationCode               String?
  /// One of the occupation's specialties (O*NET titles listed under it), optional.
  specialty                    String?
  /// The post's old career field (one of the 37), kept read-only from before occupations.
  legacyField                  String?
  /// Minimum years of experience in the occupation.
  yearsRequired                Int?
  /// Skill names picked from the dictionary.
  skills                       String[]         @default([])
  /// After this time the post is no longer listed as open.
  closesAt                     DateTime?
  predictedSeniority           String?
  predictedSeniorityConfidence Float?
  predictedSeniorityModel      String?
  predictedSeniorityMetadata   Json?
  predictedSeniorityAt         DateTime?
  /// AI level queue: QUEUED, PROCESSING, DONE, AI_UNAVAILABLE, NEEDS_INPUT, or FAILED. Null = never queued.
  aiStatus                     String?
  aiStatusMessage              String?
  aiQueuedAt                   DateTime?
  aiClaimedAt                  DateTime?
  aiAttempts                   Int              @default(0)
  /// How many people the post wants to hire. Null means no limit.
  openings                     Int?             @default(1)
  status                       HiringPostStatus @default(OPEN)
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  recruiter               User                     @relation("HiringPostRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  recommendationSnapshots RecommendationSnapshot[]
  applications            HiringApplication[]

  @@index([recruiterId, status, updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([status, occupationCode])
  /// sort=closing_soon: closesAt ASC is NULLS LAST in Postgres, as the query asks.
  @@index([status, closesAt, id(sort: Desc)])
  /// sort=salary_high. The migration creates it with NULLS LAST, which Prisma cannot express.
  @@index([status, salaryMax(sort: Desc), salaryMin(sort: Desc), id(sort: Desc)])
  @@index([aiStatus, aiQueuedAt])
  @@map("hiring_posts")
}

model HiringApplication {
  id           Int                     @id @default(autoincrement())
  hiringPostId Int
  applicantId  Int
  coverLetter  String?
  status       HiringApplicationStatus @default(APPLIED)
  /// Short reason code for the latest status change (for example why it was rejected).
  statusReason String?
  /// Free text that goes with the latest status change.
  statusNote   String?
  /// Message the recruiter sends with an offer.
  offerNote    String?
  offeredAt    DateTime?
  /// When the applicant accepted or declined the offer.
  decidedAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  hiringPost HiringPost               @relation(fields: [hiringPostId], references: [id], onDelete: Cascade)
  applicant  User                     @relation("HiringApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  interviews Interview[]
  events     HiringApplicationEvent[]

  @@unique([hiringPostId, applicantId])
  @@index([applicantId, status, updatedAt, id])
  @@index([hiringPostId, status, updatedAt, id])
  @@map("hiring_applications")
}

/// One interview round for an application.
model Interview {
  id              Int             @id @default(autoincrement())
  applicationId   Int
  /// 1 for the first interview, 2 for the second, and so on.
  round           Int
  mode            InterviewMode
  durationMinutes Int             @default(45)
  /// Address, meeting link or phone number.
  location        String?
  note            String?
  /// Times the recruiter offers; the applicant picks one.
  proposedTimes   DateTime[]
  scheduledAt     DateTime?
  status          InterviewStatus @default(PROPOSED)
  /// Why the applicant asked for other times.
  rescheduleNote  String?
  createdById     Int
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("InterviewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  /// The migration also adds a partial unique index (an index over only some rows):
  /// at most one PROPOSED, RESCHEDULE_REQUESTED or SCHEDULED interview per application.
  @@index([applicationId, round])
  @@index([status, scheduledAt])
  @@map("interviews")
}

/// History of one application: each status change, interview change or note, in time order.
model HiringApplicationEvent {
  id            Int      @id @default(autoincrement())
  applicationId Int
  /// Who did it. Null when the user is gone or the system did it.
  actorId       Int?
  type          String
  data          Json?
  createdAt     DateTime @default(now())

  application HiringApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?             @relation("HiringApplicationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("hiring_application_events")
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String?
  isPrivate Boolean  @default(true)
  directKey String?  @unique
  creatorId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User             @relation("ChatRoomCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members  ChatRoomMember[]
  messages ChatMessage[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  roomId     Int
  userId     Int
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, roomId])
  @@map("chat_room_members")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([roomId, id])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Service contracts: a client sends a proposal (with versions) on a service,
// the accepted version becomes a contract with milestones, and milestones are
// paid from a demo credit wallet. The migration also adds CHECKs (database
// rules) and partial unique indexes (unique over only some rows) that Prisma
// cannot express; they are listed in the comments below.
// ---------------------------------------------------------------------------

/// Where a service's work happens.
enum WorkMode {
  REMOTE
  ONSITE
  BOTH
}

enum ProposalStatus {
  OPEN
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  ENDED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
}

enum AmendmentStatus {
  OPEN
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED
}

/// Kind of wallet movement. SEED and TOP_UP bring credits in; the others move them.
enum LedgerType {
  SEED
  TOP_UP
  FUND_HOLD
  RELEASE
  REFUND
}

enum TopUpStatus {
  PENDING
  PAID
  FAILED
}

/// A client's offer on a service. Each counter adds a version.
/// The migration adds: CHECK clientId <> freelancerId, and at most one OPEN proposal
/// per (jobId, clientId) (partial unique index proposals_one_open_per_client_job).
model Proposal {
  id            Int            @id @default(autoincrement())
  jobId         Int
  clientId      Int
  freelancerId  Int
  status        ProposalStatus @default(OPEN)
  latestVersion Int            @default(1)
  /// Who must answer next. Null once the proposal is no longer OPEN.
  turnUserId    Int?
  expiresAt     DateTime
  declineNote   String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client     User              @relation("ProposalClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer User              @relation("ProposalFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  turnUser   User?             @relation("ProposalTurnUser", fields: [turnUserId], references: [id], onDelete: Cascade)
  versions   ProposalVersion[]
  contract   Contract?
  events     ContractEvent[]

  @@index([clientId, status, updatedAt])
  @@index([freelancerId, status, updatedAt])
  @@index([status, expiresAt])
  @@map("proposals")
}

/// One version of a proposal: the brief, references, deadline and milestone list.
model ProposalVersion {
  id              Int      @id @default(autoincrement())
  proposalId      Int
  number          Int
  authorId        Int
  brief           String
  referenceLinks  String[]
  referenceImages String[]
  deadline        DateTime
  /// JSON list of { title, description?, dueDate (ISO text), amount }.
  milestones      Json
  total           Int
  createdAt       DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author   User     @relation("ProposalVersionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([proposalId, number])
  @@map("proposal_versions")
}

/// The agreed work. Copies the accepted proposal version.
/// The migration adds CHECK clientId <> freelancerId.
model Contract {
  id                     Int            @id @default(autoincrement())
  /// Null for contracts imported from old hires.
  proposalId             Int?           @unique
  jobId                  Int
  clientId               Int
  freelancerId           Int
  title                  String
  brief                  String
  referenceLinks         String[]
  referenceImages        String[]
  deadline               DateTime
  total                  Int
  status                 ContractStatus @default(ACTIVE)
  /// Why it ended: FREELANCER_LATE, CLIENT_SILENT, NOT_FUNDED, MUTUAL or CLIENT_ENDED.
  endReason              String?
  /// True for contracts made from old hires. They have no ledger rows.
  imported               Boolean        @default(false)
  /// An open request to end the contract early (asked by one side, answered by the other).
  endRequestedById       Int?
  endRequestNote         String?
  /// What happens to a SUBMITTED milestone's credits: APPROVE or REFUND.
  endRequestChoice       String?
  /// The SUBMITTED milestone and its latest submission that the client's choice was made for.
  /// The choice is used only while that same work is still the submitted one.
  endRequestMilestoneId  Int?
  endRequestSubmissionId Int?
  endRequestedAt         DateTime?
  completedAt            DateTime?
  endedAt                DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  proposal       Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  /// Restrict (the database refuses the delete): a service or an account with contracts cannot
  /// be deleted, so the history and the held credits stay. The app answers 409 first.
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  client         User            @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer     User            @relation("ContractFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  endRequestedBy User?           @relation("ContractEndRequester", fields: [endRequestedById], references: [id], onDelete: SetNull)
  milestones     Milestone[]
  amendments     Amendment[]
  events         ContractEvent[]
  ledger         LedgerEntry[]
  review         Comment?

  @@index([clientId, status, updatedAt])
  @@index([freelancerId, status, updatedAt])
  @@index([status])
  @@map("contracts")
}

/// One paid step of a contract. The migration adds CHECK amount >= 1.
model Milestone {
  id                 Int             @id @default(autoincrement())
  contractId         Int
  /// 1 for the first milestone, 2 for the next, and so on.
  position           Int
  title              String
  description        String?
  dueDate            DateTime
  amount             Int
  status             MilestoneStatus @default(PENDING)
  fundedAt           DateTime?
  submittedAt        DateTime?
  changesRequestedAt DateTime?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  /// True when the sweeper approved it because the client did not answer in time.
  autoApproved       Boolean         @default(false)
  /// When each deadline warning was sent (one per rule), so it is sent only once.
  lateWarnedAt       DateTime?
  silentWarnedAt     DateTime?
  unfundedWarnedAt   DateTime?

  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  submissions Submission[]
  ledger      LedgerEntry[]

  @@unique([contractId, position])
  @@index([status])
  @@map("milestones")
}

/// Work the freelancer hands in for a milestone, numbered 1, 2, 3 per milestone.
model Submission {
  id          Int      @id @default(autoincrement())
  milestoneId Int
  number      Int
  authorId    Int
  note        String
  images      String[]
  links       String[]
  /// The client's "request changes" note on this submission.
  feedback    String?
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  author    User      @relation("SubmissionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([milestoneId, number])
  @@map("submissions")
}

/// A change asked for mid-contract. The migration allows at most one OPEN amendment per
/// contract (partial unique index amendments_one_open_per_contract).
model Amendment {
  id          Int             @id @default(autoincrement())
  contractId  Int
  proposerId  Int
  status      AmendmentStatus @default(OPEN)
  note        String?
  /// A new overall contract deadline, if the amendment moves it.
  deadline    DateTime?
  /// JSON list of the changes (add a milestone, move a due date, change an amount).
  changes     Json
  declineNote String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  proposer User     @relation("AmendmentProposer", fields: [proposerId], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt])
  @@map("amendments")
}

/// History of a proposal or contract: one row per step, shown as a timeline.
model ContractEvent {
  id         Int      @id @default(autoincrement())
  proposalId Int?
  contractId Int?
  /// Who did it. Null when the user is gone or the system (sweeper, import) did it.
  actorId    Int?
  type       String
  data       Json?
  createdAt  DateTime @default(now())

  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actor    User?     @relation("ContractEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([proposalId, createdAt])
  @@map("contract_events")
}

/// One demo credit wallet per user. The migration adds CHECKs available >= 0 and held >= 0.
model Wallet {
  userId    Int      @id
  available Int      @default(0)
  /// Credits the client has put on funded milestones and not yet released or refunded.
  held      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// One wallet movement, with the balances after it.
/// The migration adds CHECK availableDelta <> 0 OR heldDelta <> 0 (a row always moves something).
model LedgerEntry {
  id             Int        @id @default(autoincrement())
  userId         Int
  type           LedgerType
  availableDelta Int
  heldDelta      Int
  availableAfter Int
  heldAfter      Int
  contractId     Int?
  milestoneId    Int?
  topUpId        Int?
  /// The other person in the move (the freelancer on a release, the client on an earning).
  counterpartyId Int?
  createdAt      DateTime   @default(now())

  user         User       @relation("LedgerEntryOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Ledger rows are money history: when a contract, milestone or top-up row goes away the
  // entry stays (its link becomes null) so the wallet still adds up.
  contract     Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  topUp        TopUp?     @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  counterparty User?      @relation("LedgerEntryCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([contractId])
  @@map("ledger_entries")
}

/// A VNPay sandbox top-up. txnRef is unique so each payment adds credits only once.
/// The migration adds CHECK credits BETWEEN 10 AND 10000.
model TopUp {
  id                   Int         @id @default(autoincrement())
  userId               Int
  credits              Int
  /// The credits' value in the demo economy (credits x 1,000 VND). Stripe charges amountMinor/currency.
  amountVnd            Int
  txnRef               String      @unique
  status               TopUpStatus @default(PENDING)
  /// Which gateway took the money: "VNPAY" (older top-ups) or "STRIPE".
  provider             String      @default("STRIPE")
  /// VNPay fields, kept for the older top-ups.
  vnpTransactionNo     String?
  bankCode             String?
  responseCode         String?
  /// Stripe: the Checkout Session id (cs_test_...), saved when the top-up starts.
  gatewayTransactionId String?
  /// What the gateway charged, in its smallest unit (US cents for Stripe), and the currency code.
  amountMinor          Int?
  currency             String?
  paidAt               DateTime?
  createdAt            DateTime    @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]

  @@index([userId, createdAt])
  @@map("top_ups")
}
