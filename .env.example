# Database
DATABASE_URL="postgresql://jobaura:jobaura_password@127.0.0.1:5434/jobaura_dev?schema=public"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# JWT
JWT_SECRET="replace-with-a-random-secret-at-least-64-characters-long"
JWT_EXPIRES_IN="10m"
JWT_ISSUER="jobaura"
JWT_AUDIENCE="jobaura-api"
AUTH_REFRESH_TTL_DAYS=14
AUTH_REDIS_URL="redis://localhost:6379"
# For a password-protected local Redis, use a private file, not a committed password.
# AUTH_REDIS_PASSWORD_FILE="E:/clone/NestjsBE/.tmp/dev-auth-redis-password"
AUTH_REDIS_COMMAND_TIMEOUT_MS=200
AUTH_REDIS_CONNECT_TIMEOUT_MS=1000

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3002/api/auth/google/callback"

# Frontend URL (for redirects after OAuth)
FRONTEND_URL="http://localhost:3000"

# Server
PORT=3002
GLOBAL_PREFIX="api"
NODE_ENV="development"

# Redis (optional - falls back to in-memory cache if not provided)
# REDIS_URL is only for a SEPARATE general cache/realtime Redis, never auth Redis.
# REDIS_URL="redis://localhost:6380"

# AI recommendation service
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_SERVICE_API_KEY="replace-with-the-same-key-used-by-ai-service"
AI_SERVICE_TIMEOUT_MS=10000
AI_RECOMMENDATION_MODEL_VERSION="current"
RECOMMENDATION_SNAPSHOT_MAX_AGE_SECONDS=86400

# Service contracts (optional). Every 3-day deadline window, in minutes (4320 = 3 days;
# set 10 for a quick demo). The sweeper runs every CONTRACT_SWEEP_INTERVAL_MS (0 turns it off).
CONTRACT_GRACE_MINUTES=4320
CONTRACT_SWEEP_INTERVAL_MS=60000

# LiveKit video calls for online interviews (optional; without them the call-token endpoint answers 503)
# Create a LiveKit Cloud project (free Build plan) and paste its URL (wss://...) and API key and secret here.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
